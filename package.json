{
  "name": "qwiza-back",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "postinstall": "npm run build -w @qwiza/minigames && npm run db:generate -w @qwiza/api",
    "predev": "npm run build -w @qwiza/minigames",
    "dev": "npm run dev -w @qwiza/api",
    "prebuild": "npm run build -w @qwiza/minigames",
    "build": "npm run build -w @qwiza/api",
    "start": "npm run start -w @qwiza/api",
    "pretypecheck": "npm run build -w @qwiza/minigames",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "pretest": "npm run build -w @qwiza/minigames",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @qwiza/api",
    "db:deploy": "npm run db:deploy -w @qwiza/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
